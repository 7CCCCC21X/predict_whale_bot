# Telegram
# 真正部署到 Railway 时，不要上传 .env，把这些填到 Railway Variables。
TG_BOT_TOKEN=123456:replace_me
TG_CHAT_ID=-1001234567890

# Predict API
PREDICT_API_KEY=
PREDICT_API_BASE=https://api.predict.fun
PREDICT_WS_URL=wss://ws.predict.fun/ws

# 监控模式：
# matches = 成交大单，推荐先用这个
# orderbook = 盘口大挂单
# both = 成交 + 盘口都开
MODE=matches

# 成交大单阈值，单位 USDT
THRESHOLD_USDT=1000

# Predict 的 minValueUsdtWei 默认按 1e18 转换
USDT_WEI_DECIMALS=18

# 成交轮询
POLL_INTERVAL_SEC=3
MATCHES_PAGE_SIZE=100
# 高峰期最多翻多少页，遇到 seen 的事件就停。fetch_new_matches 里写到日志若翻满
# 仍没追上，说明流量超过轮询能力，可以加大此值或减小 POLL_INTERVAL_SEC。
MATCHES_MAX_PAGES=5

# 默认开启：seen 会持久化到 SEEN_STATE_PATH，重启续跑不会重复推送。
# 真正的"全新部署 + 文件不存在"会有自动 seed 流程，不会刷屏。
ALERT_ON_STARTUP=true

# 重启续跑用：保存已推送过的事件 ID。Railway 容器重启会丢 /tmp，
# 想要真正的跨重启持久化，请挂 volume 到此路径或换成 volume 内的路径。
SEEN_STATE_PATH=/tmp/predict_seen.json

# 盘口挂单监控参数，仅 MODE=orderbook/both 使用
ORDERBOOK_THRESHOLD_USDT=1000
MARKET_REFRESH_SEC=300
ORDERBOOK_SUB_BATCH=80

LOG_LEVEL=INFO
REQUEST_TIMEOUT_SEC=12
PYTHONUNBUFFERED=1
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30

# 市场链接模板（默认指向 predict.fun 前端），{id} / {slug} / {title} 占位
# 留空 = 不附链接
MARKET_URL_TEMPLATE=https://predict.fun/event/{slug}

# 交易哈希链接模板（默认指向 BNB Chain 浏览器），{hash} 占位
# 留空 = 只显示完整哈希
TX_URL_TEMPLATE=https://bscscan.com/tx/{hash}
