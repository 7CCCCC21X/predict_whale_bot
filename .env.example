# =====================================================
# Telegram
# =====================================================
# 真正部署到 Railway 时，不要上传 .env，把这些填到 Railway Variables。
TG_BOT_TOKEN=123456:replace_me
TG_CHAT_ID=-1001234567890

# 改阈值的管理员 user_id 列表，逗号分隔。空 = 不限制（向后兼容）。
# 用 /whoami 命令可以查到自己的 user_id。
# 例：ALLOWED_USER_IDS=12345678,98765432
ALLOWED_USER_IDS=

# =====================================================
# Predict API
# =====================================================
PREDICT_API_KEY=
PREDICT_API_BASE=https://api.predict.fun
PREDICT_WS_URL=wss://ws.predict.fun/ws

# Predict API 调用失败的最大重试次数（429/5xx/网络错误，指数退避 + jitter）
API_MAX_RETRIES=5

# 监控模式：
# matches = 成交大单，推荐先用这个
# orderbook = 盘口大挂单
# both = 成交 + 盘口都开
MODE=matches

# =====================================================
# 阈值（也可以通过 Telegram /menu 在线改，会自动持久化）
# =====================================================
THRESHOLD_USDT=1000
ORDERBOOK_THRESHOLD_USDT=1000

# USDT 价值字段的 wei 小数位（valueUsdt / priceExecuted 等）
USDT_WEI_DECIMALS=18
# 份额量字段的 wei 小数位（amountFilled / fee.amount / orderbook size 等）。
# Predict 实际是 18 位（份额 × 1e18），跟 USDT 一致。
# 如果将来某个市场用别的精度且份额数显示偏离 1eN 倍，调这个值。
SHARES_WEI_DECIMALS=18

# =====================================================
# 成交轮询
# =====================================================
POLL_INTERVAL_SEC=3
MATCHES_PAGE_SIZE=100
# 高峰期最多翻多少页，遇到 seen 就停。翻满还没追上日志会警告。
MATCHES_MAX_PAGES=5

# 默认开：seen 会持久化，重启续跑不会重复推送。
# 真正的"全新部署 + 文件不存在"会自动只 seed 一页，不会刷屏。
ALERT_ON_STARTUP=true

# =====================================================
# 状态持久化
# Railway 必须挂 Volume 到 /data，否则容器重启会丢这些文件，
# 阈值会回到 env 默认、市场会重新 seed。
# =====================================================
SEEN_STATE_PATH=/data/predict_seen.json
SEEN_MARKETS_PATH=/data/predict_seen_markets.json
RUNTIME_STATE_PATH=/data/runtime_state.json
MAX_SEEN_IDS=10000

# =====================================================
# 盘口挂单监控（仅 MODE=orderbook/both 使用）
# =====================================================
MARKET_REFRESH_SEC=300
ORDERBOOK_SUB_BATCH=80

# =====================================================
# 链接模板
# =====================================================
# 市场链接（默认 predict.fun 中文版 + 推荐 ref），{id} / {slug} / {title}
MARKET_URL_TEMPLATE=https://predict.fun/zh-cn/market/{slug}?ref=B00EA
# 交易哈希链接（BNB Chain 浏览器），{hash}
TX_URL_TEMPLATE=https://bscscan.com/tx/{hash}
# Taker 钱包链接（默认 predict.fun portfolio 页 + 推荐 ref），{address} / {username}
# 想用 BscScan 钱包页就改成 https://bscscan.com/address/{address}
USER_URL_TEMPLATE=https://predict.fun/zh-cn/portfolio/{address}?ref=B00EA

# =====================================================
# 新市场上线告警
# =====================================================
WATCH_NEW_MARKETS=true
NEW_MARKETS_CHECK_SEC=120

# =====================================================
# 杂项
# =====================================================
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SEC=12
PYTHONUNBUFFERED=1
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
