# Telegram
# 1) 找 @BotFather 创建机器人，拿 token
# 2) 把机器人拉进群/频道，或先私聊机器人
# 3) 获取 chat_id 后填这里
TG_BOT_TOKEN=123456:replace_me
TG_CHAT_ID=-1001234567890

# Predict API
PREDICT_API_KEY=
PREDICT_API_BASE=https://api.predict.fun
PREDICT_WS_URL=wss://ws.predict.fun/ws

# 监控模式：
# matches = 成交大单，推荐先用这个
# orderbook = 盘口大挂单
# both = 成交 + 盘口都开
MODE=matches

# 成交大单阈值，单位 USDT
THRESHOLD_USDT=1000

# Predict 的 minValueUsdtWei 默认按 1e18 转换
USDT_WEI_DECIMALS=18

# 成交轮询
POLL_INTERVAL_SEC=8
MATCHES_PAGE_SIZE=30

# false = 启动时只记录最近历史成交，不推送历史告警，避免刷屏
ALERT_ON_STARTUP=false

# 盘口挂单监控参数，仅 MODE=orderbook/both 使用
ORDERBOOK_THRESHOLD_USDT=1000
MARKET_REFRESH_SEC=300
ORDERBOOK_SUB_BATCH=80

LOG_LEVEL=INFO
REQUEST_TIMEOUT_SEC=12
